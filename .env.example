# SL Strength OS — environment configuration
#
# Copy this file to `.env.local` and fill in the values to connect the live
# Notion backend. With no key set, the app runs in "sample mode" and serves
# the bundled sample data (the prototype still works end to end).

# Notion integration secret (https://www.notion.so/my-integrations).
# The integration must be shared with the SL Strength OS databases.
NOTION_API_KEY=

# Optional: which client the portal logs in as (by email).
# Defaults to the first Active client when unset.
NOTION_DEMO_CLIENT_EMAIL=

# Optional: public lead application form URL (the "Copy application link"
# button on the Leads page). Defaults to the live SL Strength form when unset.
NEXT_PUBLIC_APPLICATION_FORM_URL=

# Optional: site password wall. When set, the whole site requires this password
# (one shared login). Leave unset to keep the app open (e.g. local dev).
SITE_PASSWORD=

# Optional: AI advisor layer (the Approvals inbox + agents). When set, the AI
# advisors can generate recommendations via Claude. Unset = AI layer off; the
# app runs normally and produces no recommendations (no fake data).
ANTHROPIC_API_KEY=
# Optional: override the advisor model (defaults to claude-opus-5). Set a
# cheaper model (e.g. claude-sonnet-5) for higher volume at lower cost.
ANTHROPIC_MODEL=

# Optional: shared secret protecting the automation cron endpoint
# (POST /api/agents/cron). When set, the scheduler must send it as a Bearer
# token or x-cron-secret header. Unset = the endpoint is open.
CRON_SECRET=

# Client portal auth (magic-link login). AUTH_SECRET signs the login tokens and
# session cookies — set a long random string in production (falls back to
# SITE_PASSWORD if unset). RESEND_API_KEY enables emailing login links to
# clients; without it, the coach generates a link and sends it manually.
AUTH_SECRET=
RESEND_API_KEY=
# From address for portal login emails (needs a Resend-verified domain in prod).
PORTAL_FROM_EMAIL=

# ── Nutrition Data Integration Layer ────────────────────────────────────────
# The nutrition backbone works with ZERO keys (Open Food Facts needs none), but
# adding these unlocks the primary whole-food/micronutrient source and
# restaurant/branded enrichment. Missing keys just disable that one provider.
#
# USDA FoodData Central (PRIMARY — whole foods + best micronutrients, free).
# Get a free key: https://fdc.nal.usda.gov/api-key-signup.html
USDA_FDC_API_KEY=
#
# FatSecret Platform API (ENRICHMENT — restaurant/branded/recipes, 5,000/day free).
# Register a free app: https://platform.fatsecret.com/platform-api
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
#
# Optional: identify your app to Open Food Facts (polite-use policy).
NUTRITION_USER_AGENT=
