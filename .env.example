# SL Strength OS — environment configuration
#
# Copy this file to `.env.local` and fill in the values to connect the live
# Notion backend. With no key set, the app runs in "sample mode" and serves
# the bundled sample data (the prototype still works end to end).

# Notion integration secret (https://www.notion.so/my-integrations).
# The integration must be shared with the SL Strength OS databases.
NOTION_API_KEY=

# Optional: which client the portal logs in as (by email).
# Defaults to the first Active client when unset.
NOTION_DEMO_CLIENT_EMAIL=

# Optional: public lead application form URL (the "Copy application link"
# button on the Leads page). Defaults to the live SL Strength form when unset.
NEXT_PUBLIC_APPLICATION_FORM_URL=

# Optional: site password wall. When set, the whole site requires this password
# (one shared login). Leave unset to keep the app open (e.g. local dev).
SITE_PASSWORD=
